{
  "name": "patch-relay",
  "version": "1.0.0",
  "type": "module",
  "description": "PatchRelay — the model proposes reviewed diffs with line numbers, you apply them by hand, then one click hands the work back.",
  "license": "MIT",
  "keywords": ["dsh-plugin", "code-review", "human-in-the-loop", "diff", "patch"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "diff.js",
    "client.js",
    "selfcheck.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}